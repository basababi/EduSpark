# EduSpark Production Secrets

# Generate JWT_SECRET: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production-32-bytes

# Database
DATABASE_URL=postgresql+asyncpg://eduspark:eduspark@db:5432/eduspark

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Settings
JWT_EXPIRES_MIN=30
REFRESH_EXPIRES_MIN=43200

# Allowed Origins (production: explicit HTTPS domains only)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Logging
LOG_LEVEL=DEBUG

# Optional: AI Provider
OPENAI_API_KEY=sk-your-key-here
